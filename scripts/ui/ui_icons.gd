extends RefCounted

# Painted icon set (stage 04). SVGs live in res://assets/ui/icons/<id>.svg
# (viewBox 256, regenerated by assets/ui/icons/generate_icons.py).
# Usage: const UiIcons := preload("res://scripts/ui/ui_icons.gd")
#        UiIcons.draw(self, "jaws", Rect2(x, y, 96, 96), tint)
# Small draws use a pre-shrunk Lanczos copy so icons stay crisp at 48-64 px
# without relying on mipmaps or the canvas texture filter.
# Painted PNGs (UI kit V2, 256 px, res://assets/ui/v2/icons/<id>.png) win over
# the SVG of the same id; the SVGs stay as fallback (use_painted = false).

const UiStyle := preload("res://scripts/ui/ui_style.gd")
const DIR := "res://assets/ui/icons/"
const PAINTED_DIR := "res://assets/ui/v2/icons/"
const KIT_DIR := "res://assets/ui/v2/vector/"
# Calm skin (only "calm", not "brawl"): small HUD glyphs of the V2 kit replace these icons (fixed
# kit colours, so callers draw them with a white or alpha-only tint). "v2_*"
# ids always resolve to the kit glyph, whatever the skin.
const CALM_GLYPHS := {"dna": "icon_dna", "pause": "icon_pause", "clock": "icon_timer", "biomass": "icon_biomass"}
const KIT_IDS := {
	"v2_population": "icon_population", "v2_dna": "icon_dna", "v2_threat": "icon_threat",
	"v2_timer": "icon_timer", "v2_biomass": "icon_biomass", "v2_pause": "icon_pause", "v2_rally": "icon_rally",
}
# Expansion art (UI kit V2 EXPANSION_ASSETS, 256 px copies in assets/ui/v3/icons/,
# built by assets/ui/v3/build_v3.py): id -> file. Wins over PAINTED and the SVG
# while use_painted is on; only ids whose motif matches the game meaning.
const V3_DIR := "res://assets/ui/v3/"
const V3_ICONS := {
	"rudelbiss": "icons/leap", "saeurespucker": "icons/acid_spit", "sporenwolke": "icons/spore_burst",
	"blitzbiss": "icons/sickle_slash", "graeber": "icons/slam", "meute": "icons/swarm_wave",
	"nest": "icons/brood_nest", "totem": "icons/curse_totem",
	"currency_dna": "icons/dna", "currency_biomass": "icons/biomass",
	"branch_growth": "icons/hunger_mass", "branch_attack": "icons/razor_offense",
	"branch_protect": "icons/carapace_survival", "branch_special": "icons/mutation_special",
	# Boss portrait (bust) for bars and result rows.
	"portrait_bog_king": "bosses/bog_king",
}
# Icon standard V4 (Supercell style, ART_UI_PLAN.md "Icon-Standard"): the
# painted icons above with one common crop, contour and category recolours,
# plus white control glyphs, built by assets/ui/v4/build_icons_v4.py. Wins
# over V3/V2/SVG while use_v4 and use_painted are on (calm glyphs still win).
const V4_DIR := "res://assets/ui/v4/icons/"
const V4_ICONS := [
	"jaws", "brood", "glutton", "pack", "scatter", "armor",
	"rudelbiss", "sporenwolke", "saeurespucker", "blitzbiss", "graeber", "meute", "nest", "totem",
	"dna", "biomass", "currency_dna", "currency_biomass",
	"branch_growth", "branch_attack", "branch_protect", "branch_special",
	"stachelruecken", "aetzflut", "brutsack", "erdbeben", "sturmrudel", "regeneration", "dornenhaut",
	"essence", "crown_tooth", "skull", "mawling_head", "mawling_head_color", "crown", "alpha_core",
	"trophy", "biome_verdant", "biome_glutsumpf", "diff_wild", "diff_brutal", "diff_apex",
	"hunter", "skitter", "leaper", "nibbler", "bog_king", "instinct", "hub",
	"pause", "play", "clock", "lock", "reroll", "restart", "banish", "skip",
]
# White V4 control glyphs with dark contour: a tint colours them (like text).
const V4_GLYPHS := ["pause", "play", "clock", "lock", "reroll", "restart", "banish", "skip"]
# Painted currency icons with a fixed palette: a tint only fades or dims them
# (callers still pass the old cyan/amber tints of the flat glyphs).
const FIXED_COLOUR := ["dna", "biomass", "currency_dna", "currency_biomass"]
# Ids with a painted V2 icon (the six base traits / Anlagen).
const PAINTED := ["jaws", "brood", "glutton", "pack", "scatter", "armor"]
const IDS := [
	"jaws", "brood", "glutton", "pack", "scatter", "armor",
	"rudelbiss", "sporenwolke", "saeurespucker", "stachelruecken", "aetzflut", "meute",
	"graeber", "blitzbiss", "brutsack", "erdbeben", "sturmrudel", "regeneration", "dornenhaut",
	"essence", "crown_tooth", "dna", "skull", "mawling_head", "mawling_head_color",
	"crown", "alpha_core", "pause", "lock", "trophy", "biome_verdant", "biome_glutsumpf",
	"diff_wild", "diff_brutal", "diff_apex", "clock", "reroll", "banish", "skip",
	"biomass", "hunter", "skitter", "leaper", "nibbler", "bog_king",
	"up_brood_size", "up_bite", "up_chitin", "up_sprint", "up_digest", "up_gene",
	"up_attack_slot", "up_trait_slot", "instinct", "restart", "hub",
	"nest", "totem", "currency_dna", "currency_biomass",
	"branch_growth", "branch_attack", "branch_protect", "branch_special", "portrait_bog_king", "play",
]
# Alternative names resolved by has()/texture()/draw().
const ALIASES := {"prey": "nibbler", "boss": "bog_king"}
# Pre-shrunk sizes in texture pixels; the smallest one >= the drawn size wins.
const BUCKETS := [40, 64, 96, 128, 192]

static var use_painted := true
static var use_v4 := true
static var _full: Dictionary = {}
static var _small: Dictionary = {}


static func path(id: String) -> String:
	id = ALIASES.get(id, id)
	if KIT_IDS.has(id):
		return KIT_DIR + KIT_IDS[id] + ".svg"
	if UiStyle.skin == "calm" and CALM_GLYPHS.has(id):
		return KIT_DIR + CALM_GLYPHS[id] + ".svg"
	if use_v4 and use_painted and V4_ICONS.has(id) and ResourceLoader.exists(V4_DIR + id + ".png"):
		return V4_DIR + id + ".png"
	if V3_ICONS.has(id) and (use_painted or not ResourceLoader.exists(DIR + id + ".svg")):
		return V3_DIR + V3_ICONS[id] + ".png"
	if use_painted and PAINTED.has(id) and ResourceLoader.exists(PAINTED_DIR + id + ".png"):
		return PAINTED_DIR + id + ".png"
	return DIR + id + ".svg"


## True when `id` is drawn as a fixed-colour V2 kit glyph (tint only with alpha).
static func is_glyph(id: String) -> bool:
	return path(id).begins_with(KIT_DIR)


## True when `id` is drawn from a painted PNG with its own colours (V2/V3/V4,
## not the tintable white V4 glyphs).
static func is_painted(id: String) -> bool:
	var p := path(id)
	return p.ends_with(".png") and not is_tint_glyph(id)


## True when `id` is a white V4 control glyph: the tint colours it.
static func is_tint_glyph(id: String) -> bool:
	id = ALIASES.get(id, id)
	return V4_GLYPHS.has(id) and path(id).begins_with(V4_DIR)


## Switches the V4 icon standard on or off (before/after sheets). The caches
## are keyed by file path, so both sets can be drawn in the same frame.
static func set_v4(enabled: bool) -> void:
	use_v4 = enabled


## Switches between painted PNGs and the SVG set (clears the caches).
static func set_painted(enabled: bool) -> void:
	if use_painted == enabled:
		return
	use_painted = enabled
	_full.clear()
	_small.clear()


static func has(id: String) -> bool:
	return texture(id) != null


# Full-resolution texture (256 px) or null when the icon does not exist.
static func texture(id: String) -> Texture2D:
	var p := path(id)
	if not _full.has(p):
		_full[p] = load(p) if ResourceLoader.exists(p) else null
	return _full[p]


# Texture suited for drawing at `pixels` screen size (falls back to full size).
static func texture_for_size(id: String, pixels: float) -> Texture2D:
	id = ALIASES.get(id, id)
	var full := texture(id)
	if full == null:
		return null
	var bucket := 0
	for b in BUCKETS:
		if b >= pixels * 1.15:
			bucket = b
			break
	if bucket == 0 or bucket >= full.get_width():
		return full
	var key := "%s@%d" % [path(id), bucket]
	if not _small.has(key):
		var image := full.get_image()
		if image == null:
			_small[key] = full
		else:
			if image.is_compressed():
				image.decompress()
			image.resize(bucket, bucket, Image.INTERPOLATE_LANCZOS)
			_small[key] = ImageTexture.create_from_image(image)
	return _small[key]


# Draws the icon fitted into rect (aspect kept, centred). Missing icons draw a
# quiet placeholder so layouts stay readable while assets are being made.
static func draw(canvas: CanvasItem, id: String, rect: Rect2, tint := Color.WHITE) -> void:
	var side := minf(rect.size.x, rect.size.y)
	var fitted := Rect2(rect.position + (rect.size - Vector2(side, side)) * 0.5, Vector2(side, side))
	var viewport_scale := 1.0
	if canvas.is_inside_tree():
		viewport_scale = canvas.get_global_transform_with_canvas().get_scale().x \
			* canvas.get_viewport().get_final_transform().get_scale().x
	var tex := texture_for_size(id, side * absf(viewport_scale))
	if tex == null:
		_placeholder(canvas, fitted, tint)
		return
	if is_glyph(id) or (FIXED_COLOUR.has(ALIASES.get(id, id)) and path(id).begins_with(V4_DIR)):
		# Kit glyphs and V4 currencies carry their palette colour; a tint only fades or dims them.
		var v := maxf(tint.r, maxf(tint.g, tint.b))
		tint = Color(v, v, v, tint.a) if v < 0.6 else Color(1, 1, 1, tint.a)
	canvas.draw_texture_rect(tex, fitted, false, tint)


static func _placeholder(canvas: CanvasItem, rect: Rect2, tint: Color) -> void:
	var c := rect.get_center()
	var r := rect.size.x * 0.38
	canvas.draw_circle(c, r, Color(0.05, 0.11, 0.08, 0.6 * tint.a))
	canvas.draw_arc(c, r, 0.0, TAU, 32, Color(0.95, 0.9, 0.8, 0.45 * tint.a), maxf(2.0, r * 0.12), true)
	canvas.draw_circle(c, r * 0.18, Color(0.95, 0.9, 0.8, 0.45 * tint.a))
