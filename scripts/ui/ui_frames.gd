extends RefCounted

# Frame kit (stage 04, agent FRAMES). Organic SVG frames drawn as nine-slices so
# corners, claws, notches and cell holes never stretch. Usage from any Control:
#   const UiFrames := preload("res://scripts/ui/ui_frames.gd")
#   UiFrames.card(self, rect, UiStyle.EMBER)          # in _draw()
#
# Conventions
# - `rect` is always the visible frame box in base-viewport pixels (900 x 1600).
#   Glow, horns and claws may reach a few pixels outside it (pad).
# - SVGs live in assets/ui/frames/, generated by generate_frames.py and
#   imported with svg/scale = 2.0; everything is drawn at 1/SVG_SCALE so it stays
#   sharp on phones.
# - Layers: *_glow (tinted, soft, drawn first), *_body (fixed dark colours),
#   *_edge (white, tinted with the accent). Bone claws keep their own colour.
# - Every draw call resets the canvas transform to identity afterwards.
# - Small rects shrink the whole frame uniformly instead of squashing corners.

const UiStyle := preload("res://scripts/ui/ui_style.gd")

const DIR := "res://assets/ui/frames/"
const SVG_SCALE := 2.0

# Nine-slice margins in SVG units (left, top, right, bottom), including padding.
const CARD_MARGINS := Vector4(150, 100, 150, 100)
const CARD_PAD := 18.0          # svg units between texture edge and visual box
const CARD_INSETS := Vector4(42, 36, 38, 36)  # visual box -> inner body (l, t, r, b)
const PANEL_MARGINS := Vector4(44, 40, 44, 40)
const PANEL_PAD := 10.0
const PANEL_INSET := 10.0
const PILL_MARGINS := Vector4(32, 28, 32, 28)
const PILL_PAD := 6.0
const PILL_HEIGHT := 48.0
const BUTTON_MARGINS := Vector4(48, 40, 48, 40)
const BUTTON_PAD := 12.0
const BUTTON_HEIGHT := 72.0
const ROUND_TEX := 340.0        # round_* textures; ring r 100, cradle outer edge r 127
const ROUND_RADIUS := 127.0     # fitted to the rect; claws reach a bit further
const BAR_MARGINS := Vector4(14, 12, 14, 12)
const BAR_HEIGHT := 28.0
const VINE_MARGINS := Vector4(100, 0, 50, 0)
const VINE_SIZE := Vector2(260, 96)
const VINE_STEM_Y := 64.0
const CLAW_SIZE := Vector2(60, 120)
const CLAW_PIVOT := Vector2(30, 114)
const TOOTH_SIZE := Vector2(40, 64)
const TOOTH_PIVOT := Vector2(20, 4)

const DISABLED_TINT := Color(0.46, 0.5, 0.47)

static var _boxes: Dictionary = {}


# ------------------------------------------------------------------ frames

# Mutation card. state: "normal", "pressed", "disabled", "selected" (extra glow).
static func card(canvas: CanvasItem, rect: Rect2, accent: Color, state: String = "normal") -> void:
	var k := _fit(rect, CARD_MARGINS, CARD_PAD)
	var box := rect
	var edge := accent
	var glow := 0.7
	var body := Color.WHITE
	match state:
		"pressed":
			box = rect.grow(-4.0)
			glow = 1.0
			body = Color(0.82, 0.86, 0.84)
		"selected":
			glow = 1.35
		"disabled":
			edge = accent.lerp(DISABLED_TINT, 0.78)
			edge.a = 0.8
			glow = 0.0
			body = Color(0.8, 0.8, 0.8, 0.92)
	var outer := box.grow(CARD_PAD * k)
	if glow > 0.0:
		_slice(canvas, "card_glow", outer, CARD_MARGINS, _alpha(accent, minf(glow, 1.0)), k, true)
		if glow > 1.0:
			_slice(canvas, "card_glow", outer, CARD_MARGINS, _alpha(accent, glow - 1.0), k, true)
	_slice(canvas, "card_body", outer, CARD_MARGINS, body, k, true)
	_slice(canvas, "card_edge", outer, CARD_MARGINS, edge, k, true)


# Text/icon area inside a card frame (inside the organic band).
static func card_inner(rect: Rect2) -> Rect2:
	var k := _fit(rect, CARD_MARGINS, CARD_PAD)
	return rect.grow_individual(-CARD_INSETS.x * k, -CARD_INSETS.y * k, -CARD_INSETS.z * k, -CARD_INSETS.w * k)


# Quiet HUD panel; claws adds small bone hooks at the chamfered corners.
static func panel(canvas: CanvasItem, rect: Rect2, accent: Color = UiStyle.PANEL_EDGE, claws: bool = true) -> void:
	var k := _fit(rect, PANEL_MARGINS, PANEL_PAD)
	var outer := rect.grow(PANEL_PAD * k)
	_slice(canvas, "panel_body", outer, PANEL_MARGINS, Color.WHITE, k)
	_slice(canvas, "panel_edge", outer, PANEL_MARGINS, accent, k)
	if claws:
		_slice(canvas, "panel_claws", outer, PANEL_MARGINS, Color.WHITE, k)


static func panel_plain(canvas: CanvasItem, rect: Rect2, accent: Color = UiStyle.PANEL_EDGE) -> void:
	panel(canvas, rect, accent, false)


static func panel_inner(rect: Rect2) -> Rect2:
	return rect.grow(-PANEL_INSET * _fit(rect, PANEL_MARGINS, PANEL_PAD))


# Capsule chip; radius always follows the rect height.
static func pill(canvas: CanvasItem, rect: Rect2, accent: Color = UiStyle.PANEL_EDGE) -> void:
	var k := minf(rect.size.y / PILL_HEIGHT, (rect.size.x + 2.0 * PILL_PAD) / (PILL_MARGINS.x + PILL_MARGINS.z))
	var outer := rect.grow(PILL_PAD * k)
	_slice(canvas, "pill_body", outer, PILL_MARGINS, Color.WHITE, k)
	_slice(canvas, "pill_edge", outer, PILL_MARGINS, accent, k)


# kind: "primary" (glowing ember), "secondary" (dark with bone rim), "round"
# (ring with claws, uses the largest centred circle; accent tints ring + glow).
static func button(canvas: CanvasItem, rect: Rect2, kind: String, pressed: bool = false, accent: Color = UiStyle.EMBER) -> void:
	if kind == "round":
		_round(canvas, rect, accent, pressed)
		return
	var k := minf(rect.size.y / BUTTON_HEIGHT, (rect.size.x + 2.0 * BUTTON_PAD) / (BUTTON_MARGINS.x + BUTTON_MARGINS.z))
	var box := rect
	if pressed:
		box = Rect2(rect.position + Vector2(0.0, 3.0 * k), rect.size).grow(-2.0 * k)
	var outer := box.grow(BUTTON_PAD * k)
	if kind == "primary":
		_slice(canvas, "button_glow", outer, BUTTON_MARGINS, _alpha(UiStyle.EMBER_GLOW, 0.5 if pressed else 0.85), k)
		_slice(canvas, "button_primary", outer, BUTTON_MARGINS, Color(0.84, 0.78, 0.74) if pressed else Color.WHITE, k)
	else:
		_slice(canvas, "button_secondary", outer, BUTTON_MARGINS, Color(0.78, 0.8, 0.78) if pressed else Color.WHITE, k)


# Where a caller should centre the label so it moves with the pressed state.
static func button_label_center(rect: Rect2, pressed: bool = false) -> Vector2:
	var k := rect.size.y / BUTTON_HEIGHT
	return rect.get_center() + (Vector2(0.0, 3.0 * k) if pressed else Vector2.ZERO)


static func _round(canvas: CanvasItem, rect: Rect2, accent: Color, pressed: bool) -> void:
	var radius := minf(rect.size.x, rect.size.y) * 0.5
	if pressed:
		radius *= 0.95
	var size := Vector2.ONE * ROUND_TEX * radius / ROUND_RADIUS
	var area := Rect2(rect.get_center() - size * 0.5, size)
	_tex(canvas, "round_body", area, Color(0.8, 0.82, 0.8) if pressed else Color.WHITE)
	_tex(canvas, "round_glow", area, _alpha(accent, 1.0 if pressed else 0.7))
	_tex(canvas, "round_ring", area, accent)
	_tex(canvas, "round_claws", area, Color.WHITE)


# Progress bar. segments > 0 draws separate capsules (danger meter, DNA pips).
static func bar(canvas: CanvasItem, rect: Rect2, fraction: float, color: Color, segments: int = 0) -> void:
	fraction = clampf(fraction, 0.0, 1.0)
	var k := minf(rect.size.y / BAR_HEIGHT, rect.size.x / (BAR_MARGINS.x + BAR_MARGINS.z))
	_slice(canvas, "bar_track", rect, BAR_MARGINS, Color.WHITE, k)
	var inset := maxf(2.0, 3.0 * k)
	var inner := rect.grow(-inset)
	if inner.size.x <= 1.0 or inner.size.y <= 1.0:
		return
	if segments <= 0:
		_fill(canvas, Rect2(inner.position, Vector2(inner.size.x * fraction, inner.size.y)), color)
		return
	var gap := maxf(2.0, inner.size.y * 0.22)
	var seg_w := (inner.size.x - gap * (segments - 1)) / float(segments)
	for i in segments:
		var cell := Rect2(inner.position + Vector2((seg_w + gap) * i, 0.0), Vector2(seg_w, inner.size.y))
		var local := clampf(fraction * segments - i, 0.0, 1.0)
		_fill(canvas, cell, _alpha(color, 0.14))
		if local > 0.0:
			_fill(canvas, Rect2(cell.position, Vector2(seg_w * local, cell.size.y)), color)


static func _fill(canvas: CanvasItem, rect: Rect2, color: Color) -> void:
	if rect.size.x <= 0.5:
		return
	var k := rect.size.y / BAR_HEIGHT
	var min_w := (BAR_MARGINS.x + BAR_MARGINS.z) * k
	var tint := color
	var draw_rect := rect
	if rect.size.x < min_w:
		# too short for the capsule caps: shrink the caps instead of overlapping
		k = rect.size.x / (BAR_MARGINS.x + BAR_MARGINS.z)
	_slice(canvas, "bar_fill", draw_rect, BAR_MARGINS, tint, k)


# ------------------------------------------------------------------ ornaments

# Heading vines (e.g. "MUTATION WÄHLEN"): curls at both outer ends, stems
# tapering toward the centre. gap leaves room for text between the stems.
static func divider(canvas: CanvasItem, center: Vector2, width: float, color: Color = UiStyle.BONE, gap: float = 0.0, scale: float = 1.0) -> void:
	var half := (width - gap) * 0.5
	if half <= 4.0:
		return
	var k := minf(scale, half / (VINE_MARGINS.x + VINE_MARGINS.z))
	var s := k / SVG_SCALE
	var box := _box("vine_divider", VINE_MARGINS, false)
	if box == null:
		return
	box.modulate_color = color
	var top := center.y - VINE_STEM_Y * k
	var local := Rect2(Vector2.ZERO, Vector2(half, VINE_SIZE.y * k) / s)
	canvas.draw_set_transform(Vector2(center.x - width * 0.5, top), 0.0, Vector2(s, s))
	canvas.draw_style_box(box, local)
	canvas.draw_set_transform(Vector2(center.x + width * 0.5, top), 0.0, Vector2(-s, s))
	canvas.draw_style_box(box, local)
	canvas.draw_set_transform(Vector2.ZERO)


# Bone claw. `at` is the claw root, angle 0 points the tip up (radians,
# clockwise positive), scale 1 = 60 x 120 px. Tip hooks to the right; use a
# negative scale to mirror.
static func claw(canvas: CanvasItem, at: Vector2, angle: float = 0.0, scale: float = 1.0, tint: Color = Color.WHITE) -> void:
	_ornament(canvas, "claw", CLAW_PIVOT, at, angle, scale, tint)


# Fang; `at` is the root, angle 0 points the tip down, scale 1 = 40 x 64 px.
static func tooth(canvas: CanvasItem, at: Vector2, angle: float = 0.0, scale: float = 1.0, tint: Color = Color.WHITE) -> void:
	_ornament(canvas, "tooth", TOOTH_PIVOT, at, angle, scale, tint)


static func _ornament(canvas: CanvasItem, file: String, pivot: Vector2, at: Vector2, angle: float, scale: float, tint: Color) -> void:
	var tex := UiStyle.tex(DIR + file + ".svg")
	if tex == null:
		return
	var s := scale / SVG_SCALE
	canvas.draw_set_transform(at, angle, Vector2(s, absf(s)))
	canvas.draw_texture(tex, -pivot * SVG_SCALE, tint)
	canvas.draw_set_transform(Vector2.ZERO)


# ------------------------------------------------------------------ internals

# Uniform shrink so the fixed corners of a nine-slice always fit into rect.
static func _fit(rect: Rect2, margins: Vector4, pad: float) -> float:
	var need := Vector2(margins.x + margins.z, margins.y + margins.w)
	var have := rect.size + Vector2.ONE * 2.0 * pad
	return clampf(minf(have.x / need.x, have.y / need.y), 0.2, 1.0)


static func _slice(canvas: CanvasItem, file: String, rect: Rect2, margins: Vector4, tint: Color, k: float, tile: bool = false) -> void:
	var box := _box(file, margins, tile)
	if box == null or rect.size.x <= 0.0 or rect.size.y <= 0.0:
		return
	var s := k / SVG_SCALE
	box.modulate_color = tint
	canvas.draw_set_transform(rect.position, 0.0, Vector2(s, s))
	canvas.draw_style_box(box, Rect2(Vector2.ZERO, rect.size / s))
	canvas.draw_set_transform(Vector2.ZERO)


static func _tex(canvas: CanvasItem, file: String, rect: Rect2, tint: Color) -> void:
	var tex := UiStyle.tex(DIR + file + ".svg")
	if tex != null:
		canvas.draw_texture_rect(tex, rect, false, tint)


static func _box(file: String, margins: Vector4, tile: bool) -> StyleBoxTexture:
	var key := "%s|%s" % [file, tile]
	if not _boxes.has(key):
		var tex := UiStyle.tex(DIR + file + ".svg")
		if tex == null:
			_boxes[key] = null
		else:
			var box := StyleBoxTexture.new()
			box.texture = tex
			box.texture_margin_left = margins.x * SVG_SCALE
			box.texture_margin_top = margins.y * SVG_SCALE
			box.texture_margin_right = margins.z * SVG_SCALE
			box.texture_margin_bottom = margins.w * SVG_SCALE
			if tile:
				box.axis_stretch_horizontal = StyleBoxTexture.AXIS_STRETCH_MODE_TILE_FIT
			_boxes[key] = box
	return _boxes[key]


static func _alpha(color: Color, alpha: float) -> Color:
	return Color(color.r, color.g, color.b, color.a * alpha)
